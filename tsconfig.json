{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["src/**/*.ts"]
}
